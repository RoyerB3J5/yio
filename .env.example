# The shop domain, without https:// (for example: my-store.myshopify.com)
SHOPIFY_STORE_DOMAIN=

# Create a private Storefront API token in Shopify Admin > Headless.
# This value is server-only; do not prefix it with NEXT_PUBLIC_.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Keep this pinned to a supported Storefront API version.
SHOPIFY_STOREFRONT_API_VERSION=